rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'kravoplatnumzofficial@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isNotRevoked(userId) {
      return !exists(/databases/$(database)/documents/users/$(userId)) ||
             get(/databases/$(database)/documents/users/$(userId)).data.get('status', 'active') != 'revoked';
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Admin Profile Validation
    function isValidAdminProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             data.role is string && data.role.size() <= 20;
    }

    // User Profile Validation
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'channelSlug', 'brandName']) &&
             data.uid is string && data.uid.size() <= 128 &&
             data.channelSlug is string && data.channelSlug.size() <= 64 &&
             data.channelSlug.matches('^[a-zA-Z0-9_\\-]+$') &&
             data.brandName is string && data.brandName.size() <= 80 &&
             (!('role' in data) || (data.role is string && data.role.size() <= 20)) &&
             (!('status' in data) || (data.status is string && data.status.size() <= 20)) &&
             (!('revokedReason' in data) || (data.revokedReason is string && data.revokedReason.size() <= 200));
    }

    // Live Match Validation
    function isValidLiveMatch(data) {
      return data.keys().hasAll(['ownerUid', 'channelSlug', 'name1', 'name2', 'score1', 'score2', 'raceTo', 'updatedAt']) &&
             data.ownerUid is string && data.ownerUid.size() <= 128 &&
             data.channelSlug is string && data.channelSlug.size() <= 64 &&
             data.name1 is string && data.name1.size() <= 64 &&
             data.name2 is string && data.name2.size() <= 64 &&
             data.score1 is number && data.score1 >= 0 && data.score1 <= 999 &&
             data.score2 is number && data.score2 >= 0 && data.score2 <= 999 &&
             data.raceTo is number && data.raceTo >= 1 && data.raceTo <= 999 &&
             (!('nameBold1' in data) || data.nameBold1 is bool) &&
             (!('nameBold2' in data) || data.nameBold2 is bool) &&
             (!('showPot' in data) || data.showPot is bool) &&
             (!('activeShooter' in data) || (data.activeShooter is number && data.activeShooter >= 0 && data.activeShooter <= 2)) &&
             data.updatedAt is number;
    }

    // Match Archive Validation
    function isValidMatchArchive(data) {
      return data.keys().hasAll(['ownerUid', 'winnerName', 'winnerScore', 'runnerUpScore', 'totalFrames']) &&
             data.ownerUid is string && data.ownerUid.size() <= 128 &&
             data.winnerName is string && data.winnerName.size() <= 64 &&
             data.winnerScore is number && data.runnerUpScore is number &&
             data.totalFrames is number;
    }

    // 0. Admins collection
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isSignedIn();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin() && isValidId(adminId) && isValidAdminProfile(incoming());
    }

    // 1. Users collection
    // Regular users can get their own profile. Admin can get and list all users.
    // Regular users cannot change their role or status (cannot self-promote or un-revoke).
    // Admin can update any user to set status: 'active' or 'revoked'.
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming()) &&
                       incoming().uid == request.auth.uid &&
                       (isAdmin() || incoming().get('role', 'user') == 'user') &&
                       (isAdmin() || incoming().get('status', 'active') == 'active');
      allow update: if isValidId(userId) && isValidUserProfile(incoming()) && (
        (isOwner(userId) && incoming().uid == existing().uid &&
         (existing().get('status', 'active') != 'revoked') &&
         incoming().get('role', 'user') == existing().get('role', 'user') &&
         incoming().get('status', 'active') == existing().get('status', 'active')) ||
        (isAdmin() && incoming().uid == existing().uid)
      );
      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());
    }

    // 2. Channels collection
    // Overlays can read publicly without credentials.
    // Revoked users are prevented from creating or updating live scores.
    match /channels/{channelId} {
      allow get: if isValidId(channelId);
      allow create: if isSignedIn() && isValidId(channelId) && isValidLiveMatch(incoming()) &&
                       incoming().ownerUid == request.auth.uid &&
                       isNotRevoked(request.auth.uid);
      allow update: if isValidId(channelId) && isValidLiveMatch(incoming()) && (
        isAdmin() ||
        (isSignedIn() && (existing().ownerUid == request.auth.uid || incoming().ownerUid == request.auth.uid) && isNotRevoked(request.auth.uid))
      );
      allow delete: if isValidId(channelId) && (isAdmin() || (isSignedIn() && existing().ownerUid == request.auth.uid));

      // Match History subcollection for this channel
      match /history/{matchId} {
        allow get: if isValidId(matchId);
        allow list: if isValidId(channelId);
        allow create: if isValidId(matchId) && isValidMatchArchive(incoming()) &&
                         (isAdmin() || (isSignedIn() && incoming().ownerUid == request.auth.uid && isNotRevoked(request.auth.uid)));
        allow update: if isValidId(matchId) && isValidMatchArchive(incoming()) &&
                         (isAdmin() || (isSignedIn() && existing().ownerUid == request.auth.uid && isNotRevoked(request.auth.uid)));
        allow delete: if isValidId(matchId) && (isAdmin() || (isSignedIn() && existing().ownerUid == request.auth.uid));
      }
    }
  }
}
